{
  "extends": "@upstatement/eslint-config/react",
  "parserOptions": {
    "requireConfigFile": false,
    "ecmaVersion": 2022,
    "babelOptions": {
      "presets": ["babel-preset-gatsby"]
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "globals": {
    "__PATH_PREFIX__": "readonly"
  }
}
