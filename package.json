{
  "name": "daksh-adhar-portfolio",
  "description": "Portfolio website of Daksh Adhar",
  "version": "1.0.0",
  "author": "Daksh Adhar",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-daksh/a-daksh.github.io"
  },
  "keywords": [
    "gatsby",
    "portfolio",
    "robotics"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "develop": "gatsby develop",
    "start": "npm run develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "lint": "eslint src gatsby-config.js gatsby-node.js gatsby-ssr.js",
    "format": "prettier --write \"{src,content}/**/*.{js,json,md}\" \"*.{js,json,md}\"",
    "deploy": "gatsby build && gh-pages -d public --nojekyll",
    "prepare": "husky install",
    "compress:3d": "gltf-transform meshopt static/dexterlab/dexterlab.glb static/dexterlab/dexterlab.glb"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "babel-plugin-styled-components": "^2.1.4",
    "gatsby": "^5.12.9",
    "gatsby-plugin-image": "^3.12.3",
    "gatsby-plugin-manifest": "^5.12.3",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.12.3",
    "gatsby-plugin-sitemap": "^6.12.3",
    "gatsby-plugin-styled-components": "^6.12.0",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-source-filesystem": "^5.12.0",
    "gatsby-transformer-remark": "^6.12.0",
    "gatsby-transformer-sharp": "^5.12.0",
    "prop-types": "^15.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "7.25.9",
    "@babel/preset-react": "7.29.7",
    "@gltf-transform/cli": "4.1.1",
    "@upstatement/eslint-config": "2.0.0",
    "@upstatement/prettier-config": "^1.1.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "gh-pages": "^6.1.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.0.3"
  }
}
